# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
.mcp/

# Fetched by tools/pull_addons.py, never committed here.
.addon_cache/
addons/3d_player_controller/
addons/controls/

# Python bytecode caches from the scripts in tools/
__pycache__/
*.pyc

# Raw files pulled straight off the Twisted Metal 2 disc by tools/extract_tm2.py.
# The converted assets beside them are committed; these are just the working
# copies the converter reads, and it rebuilds them from the disc on demand.
addons/gta/assets/twistedmetal2/.src/

# Screenshots and films of the demos, including whatever Godot's Movie Maker
# mode writes. The addon README's "Filming a test run" recipe drops a .avi in
# the project root, and an uncompressed one of those runs to well over 100 MB.
recordings/
*.avi
*.mp4
